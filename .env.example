# Node.js 22.13+。不需要任何付费 API 密钥。
# 设置为 0 可以关闭启动时的网络补齐，仍可查询全部本地历史。
HISTORY_AUTO_SYNC=1

# 可选：SQLite 文件路径，默认 data/history.sqlite。
# HISTORY_DB_PATH=/absolute/path/history.sqlite

# 可选：输出详细同步日志。
# HISTORY_SYNC_LOG=1

# 事件翻译：mymemory（免密钥、小额免费）、google、libretranslate、off。
# 界面语言切换始终可用；off 仍可阅读随项目分发的缓存译文。
HISTORY_TRANSLATION_PROVIDER=mymemory
# Google Cloud Translation（由服务商计费；密钥只保存在服务端）
# GOOGLE_TRANSLATE_API_KEY=
# 自建或托管 LibreTranslate 的完整 /translate 地址
# LIBRETRANSLATE_URL=http://localhost:5000/translate
# LIBRETRANSLATE_API_KEY=
